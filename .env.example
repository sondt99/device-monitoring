# Admin credentials (required on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-long-password

# Session cookie secret (required, at least 32 random characters)
COOKIE_SECRET=change-this-to-a-random-32-plus-character-secret

# Set to true only if serving over HTTPS (behind TLS terminator like nginx/Caddy)
SECURE_COOKIES=false

# Set to true ONLY when running behind a trusted reverse proxy (nginx/Caddy).
# Lets the app read the real client IP from X-Forwarded-For so per-IP rate
# limits (e.g. the login brute-force guard) apply to the actual client. Keep
# it false when the app is exposed directly, otherwise clients can spoof their
# IP and evade rate limiting.
TRUST_PROXY=false

# Number of days to retain heartbeat records (default: 30)
BEAT_RETENTION_DAYS=30

# Enable the public status page (default: false). Devices are only shown on
# it if individually marked "public" — this flag alone exposes nothing.
ENABLE_STATUS_PAGE=false

# Key used to encrypt notification-channel secrets (webhook URLs, bot tokens)
# at rest. Base64-encoded, must decode to exactly 32 bytes. Required in
# production; generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=

# Enable a Prometheus-format /metrics endpoint (default: false)
ENABLE_METRICS=false

# Optional bearer token required to scrape /metrics. Leave unset only if
# /metrics is not reachable from outside a trusted network.
METRICS_TOKEN=
